# Copy to .env.local for local overrides. Never commit real values.
# Locally you need none of these: the app uses data/libspace.db automatically.

# --- Turso (set these in Vercel → Project → Settings → Environment Variables) ---
# From: turso db show <db-name> --url
TURSO_DATABASE_URL=
# From: turso db tokens create <db-name>
TURSO_AUTH_TOKEN=

# Add demo bookings to an empty database: "true" or "false".
# Default: true locally, false on Turso (the live site starts clean).
SEED_DEMO_BOOKINGS=

# Optional: where the local SQLite file lives (default data/libspace.db).
LIBSPACE_DB_PATH=
