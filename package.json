{
  "name": "libspace-lite",
  "version": "0.4.0",
  "private": true,
  "description": "Library room booking MVP for UTeM students \u2014 Software Project Management, Assignment 1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --conditions=react-server --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "db:snapshot": "node scripts/db-snapshot.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:reset": "node scripts/reset-db.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
